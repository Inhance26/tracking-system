# Virtual environment
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Secrets - never commit RunPod / registry credentials
.env
.env.*
*.key

# Model weights (auto-downloaded by get_models.py / ultralytics,
# and baked into the RunPod worker image by the root Dockerfile)
*.pt
*.onnx

# Footage. Recordings stay out by default - they bloat the history and only
# ever grow. The two clips below are the exception: the RunPod pod is fed by
# git pull, so a clip it has to run has to be in the repo to get there.
*.mp4
*.avi
*.mov
!cctv_footage.mp4
!my_clip.mp4

# Runtime output
zone_visits.csv
*.log

# The visit database (--db) and what export_db.py writes out of it.
# -wal/-shm are SQLite's WAL sidecar files.
*.db
*.db-wal
*.db-shm
exports/

# Self-test / audit images, regenerated on demand
yolo_check.jpg
pose_check.jpg
