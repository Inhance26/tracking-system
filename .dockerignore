# The serverless image only needs handler.py and runpod_serverless/
# requirements.txt. Everything else is the local app (video capture, tracking,
# dashboard) and would just bloat the build context RunPod uploads.
#
# Do not exclude handler.py here - it is the worker entrypoint.

